# Public site URL (used for sitemap/OG when set)
# NEXT_PUBLIC_SITE_URL=https://veerahr.com

# SMTP configuration for website form submissions
# Required to send form emails
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Optional overrides
# FORM_TO_EMAIL=admin@veerahr.com
# FORM_FROM_EMAIL=admin@veerahr.com

# Microsoft Graph (recommended for Microsoft 365 tenants with Security Defaults)
# If these are set, Graph is used before SMTP.
# GRAPH_TENANT_ID=your-entra-tenant-id
# GRAPH_CLIENT_ID=your-app-registration-client-id
# GRAPH_CLIENT_SECRET=your-app-registration-client-secret
# GRAPH_SENDER_EMAIL=admin@veerahr.com
